# Rendered by the image entrypoint via envsubst into /etc/nginx/conf.d/.
# Only variables actually present in the environment are substituted, so nginx
# runtime variables ($remote_addr, $uri, ...) pass through untouched.

# TLS and public routing terminate at the Cloudflare edge, which reaches this
# container through the cloudflared tunnel on the stack network. Plain HTTP on
# 8080, no certificate anywhere on the box.

# Both zones key on $binary_remote_addr, and the real_ip module below rewrites
# $remote_addr before either of them is evaluated. That ordering is the whole
# point: every request arrives from the cloudflared container, so without it the
# rate limiter would key the entire internet to one address and hold the door
# open for the first visitor while shutting it on everyone else.
limit_req_zone $binary_remote_addr zone=api_rl:10m rate=${NGINX_API_RATE};
limit_conn_zone $binary_remote_addr zone=api_conn:10m;

# The API answers from aggregates over the whole national register, and they are
# not cheap: /rankings/parties and /rankings/districts each took about 12s
# measured against production, /municipalities about 5s. The underlying data
# moves once a day at the very most (ingest-delta is daily, the bulk weekly), so
# serving the same answer twice out of postgres is pure waste.
#
# /var/cache/nginx is already a tmpfs, which means this cache is RAM and counts
# against the container's mem_limit. Hence a modest default and a knob.
#
# Safe across a deploy without a purge step because every request the site makes
# carries the SvelteKit build id, so a new bundle asks new URLs and can never be
# answered from the previous shape's entries. That is the same property the
# Cache-Control header already relies on.
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=apicache:10m
                 max_size=${NGINX_CACHE_SIZE} inactive=1h use_temp_path=off;

# The company profile is the one endpoint with an outbound cost: on a cache miss
# it fetches sicae.pt and empresadb.pt synchronously. Every other route is a
# local database read. Left on the general limit, somebody walking NIFs does not
# steal anything (the contract register is open data and the bulk file is faster
# than this API), they make US hammer a public register from our address, on a
# worker thread, until that register bans us from a source the site depends on.
#
# A second zone rather than a second location, so the proxy block below is not
# duplicated. An EMPTY key is not accounted by limit_req, which is what lets one
# `limit_req` directive apply to one path prefix: every other URI maps to "" and
# passes through untouched. The version segment is a wildcard on purpose, so a
# /v2 alongside /v1 is still covered without editing this file.
map $uri $company_rl_key {
    default                  "";
    ~^/api/[^/]+/companies/  $binary_remote_addr;
}
limit_req_zone $company_rl_key zone=api_companies:10m rate=${NGINX_COMPANY_RATE};

# NGINX_TRUSTED_PROXY is the stack network subnet (STACK_SUBNET in the compose),
# so the only address trusted to speak for a client is the tunnel itself.
#
# NGINX_REAL_IP_HEADER is CF-Connecting-IP in production, and that choice
# matters: Cloudflare's edge always OVERWRITES CF-Connecting-IP with the address
# it accepted the connection from, so a client cannot forge it. X-Forwarded-For
# is appended to rather than replaced, so a client that sends one moves its own
# value up the chain and, with real_ip_recursive, can walk the rate limiter off
# any address it likes. Locally there is no Cloudflare, so the default there is
# X-Forwarded-For and the trust list has to be narrowed by hand.
set_real_ip_from ${NGINX_TRUSTED_PROXY};
real_ip_header   ${NGINX_REAL_IP_HEADER};
real_ip_recursive on;

server {
    listen 8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    # Every redirect nginx generates itself must be relative. An absolute one is
    # built from $scheme://$host:$server_port, and this container listens on
    # 8080 behind a tunnel that terminates TLS elsewhere, so a directory
    # redirect handed a reader `https://ondevaiparar.com:8080/municipio/.../`:
    # the internal port, and whichever Host arrived, in a URL nothing answers on.
    # port_in_redirect is redundant once absolute_redirect is off and is set
    # anyway, because the failure is invisible until somebody hits it.
    absolute_redirect off;
    port_in_redirect  off;
    client_max_body_size   16k;     # nothing here accepts uploads
    client_body_timeout    10s;
    client_header_timeout  10s;
    send_timeout           30s;

    include /etc/nginx/security-headers.conf;

    # Only the two errors a person can actually land on get a designed page.
    # A human never sees an nginx 404: unknown paths fall through to the SPA,
    # which renders its own. Everything that does hit a 404 here is a bot, and
    # bots get 17 bytes, not 3 KB.
    error_page 429             /erro-429.html;
    error_page 500 502 503 504 /erro-5xx.html;
    location = /erro-429.html { internal; include /etc/nginx/security-headers.conf; }
    location = /erro-5xx.html { internal; include /etc/nginx/security-headers.conf; }

    # A return with a body bypasses error_page, which is how these stay cheap.
    error_page 400 401 403 404 405 413 414 @nope;
    location @nope { default_type text/plain; return 404 "not found\n"; }

    # This is a read-only site. Anything else is noise or probing.
    if ($request_method !~ ^(GET|HEAD)$) { return 405 "method not allowed\n"; }

    # /.well-known is the one dotted path that is meant to be public (RFC 8615).
    # ^~ is load-bearing: a prefix match with ^~ stops nginx ever testing the
    # regex locations below, so without it the dotfile 404 swallows security.txt.
    location ^~ /.well-known/ { try_files $uri =404; }

    # Dotfiles, editor leftovers and VCS dirs: 404, never 403 - a 403 confirms
    # the path exists. Covers /.env, /.git/config, /.svelte-kit, backups.
    location ~ (?:^|/)\.                { return 404 ""; access_log off; log_not_found off; }
    location ~ ~$                       { return 404 ""; access_log off; log_not_found off; }
    location ~* \.(bak|old|orig|swp|sql|log|ini|conf|yml|yaml|toml)$ {
        return 404 ""; access_log off; log_not_found off;
    }

    location = /healthz { return 200 "ok\n"; access_log off; add_header Content-Type text/plain; }

    # Content-hashed bundles never change under the same name.
    location /_app/immutable/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Everything the build does NOT content-hash: fonts, the geometry file, the
    # preview card, the icons. Without this they fall through to `location /`
    # and inherit no-cache, so each page load revalidates four woff2 files and
    # the map tab revalidates 400 KB of geometry, and Cloudflare cannot hold any
    # of it at the edge. No `immutable`: unlike the bundles these keep their
    # filename when their content changes (the Bowlby One file has already been
    # re-saved once), so a year-long pin would strand readers on the old copy.
    location ~* ^/(fonts/|pt-(?:municipios|distritos)\.geojson$|og\.png$|favicon\.svg$|apple-touch-icon\.png$) {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;  # a week
        try_files $uri =404;
    }

    location /api/ {
        include /etc/nginx/security-headers.conf;
        limit_req  zone=api_rl burst=${NGINX_API_BURST} nodelay;
        # Only bites on /api/*/companies/; see the map above. nginx applies
        # whichever zone is the more restrictive for the request at hand.
        limit_req  zone=api_companies burst=${NGINX_COMPANY_BURST} nodelay;
        limit_conn api_conn 20;
        limit_req_status 429;

        # A cold /rankings/parties costs 12s, so the stampede guard matters more
        # than the cache: proxy_cache_lock sends ONE request upstream and makes
        # the rest wait for its answer, instead of handing postgres fifty
        # identical twelve-second aggregates. background_update plus the
        # `updating` stale rule then refreshes an expired entry behind a reader
        # who is already being served, so nobody waits for a revalidation.
        #
        # Only 200s are cached. A 404 from the API is a real answer about one
        # NIF and cheap to repeat; a 5xx must never be remembered.
        proxy_cache apicache;
        proxy_cache_valid 200 ${NGINX_CACHE_TTL};
        proxy_cache_key $request_method$host$request_uri;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 30s;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_methods GET HEAD;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_pass http://${NGINX_API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout   60s;
        proxy_buffering on;
        # only for a dead upstream: a 404 from the API is JSON and must stay JSON
        proxy_intercept_errors off;
        # uvicorn announces itself; nothing upstream needs a name of its own
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
    }

    # SPA: unknown paths are client-side routes, so the shell is returned.
    #
    # $uri/index.html comes BEFORE $uri/, and that order is the whole of it.
    # scripts/prerender.mjs writes build/municipio/<nif>/index.html, so those
    # paths are directories now; `$uri/` matches a directory by issuing a 301 to
    # the trailing-slash form first, which is a redirect a reader can see, and
    # which fights the canonical: the sitemap and the canonical link both spell
    # these URLs WITHOUT a trailing slash. Naming the index file directly serves
    # it with no redirect at all and keeps the one spelling. /en is the same
    # case. $uri/ stays last for a reader who typed the slash themselves.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;   # shell must revalidate
        try_files $uri $uri/index.html $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/manifest+json;
}
