#!/usr/bin/env sh
# contratos-publicos pre-commit checks.
#
# Version controlled rather than living in .git/hooks, so a fresh clone gets
# them with one command:
#
#   git config core.hooksPath .githooks
#
# gitleaks runs in Docker when no local binary exists, which is how the rest of
# this project already works. Pinned, never :latest, same rule as the images.
#
# Bypass with `git commit --no-verify` when you genuinely must.

set -eu

GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v8.30.1"
MAX_BYTES=2097152   # 2 MiB; the 400 KB geometry file is the largest thing we keep

red()  { printf '\033[31m%s\033[0m\n' "$1" >&2; }
warn() { printf '\033[33m%s\033[0m\n' "$1" >&2; }
ok()   { printf '\033[32m%s\033[0m\n' "$1"; }

fail=0

# ---------------------------------------------------------------- staged set
# -z and a null-delimited read, because Portuguese filenames carry spaces and
# accents and this repo is full of them.
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

# ------------------------------------------------------- 1. never commit .env
# .gitignore already covers it, but `git add -f` does not care and a leaked
# POSTGRES_PASSWORD is not something you can un-push.
if printf '%s\n' "$staged" | grep -qxE '\.env|.*/\.env|\.env\.[a-z]+' ; then
  if ! printf '%s\n' "$staged" | grep -qx '\.env\.example'; then
    red "An environment file is staged. .env holds real credentials."
    printf '%s\n' "$staged" | grep -E '\.env' >&2
    fail=1
  fi
fi

# ------------------------------------------------------ 2. accidental payload
# A multi-hundred-MB IMPIC download or a database dump wandering into git is
# unrecoverable in practice, so stop it at the door.
printf '%s\n' "$staged" | while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -gt "$MAX_BYTES" ]; then
    red "$f is $(( size / 1024 )) KB, over the $(( MAX_BYTES / 1024 )) KB limit."
    red "If it really belongs in the repo, commit with --no-verify."
    exit 1
  fi
done || fail=1

# --------------------------------------------------- 3. the project em dash rule
# CLAUDE.md: never an em dash in user-facing text. Source data quoted verbatim
# is fine, which is why this only looks at the files we write ourselves.
dashes=$(printf '%s\n' "$staged" \
  | grep -E '^(web/src|api|core|ingest)/.*\.(svelte|ts|py)$' || true)
if [ -n "$dashes" ]; then
  hits=$(printf '%s\n' "$dashes" | tr '\n' '\0' | xargs -0 grep -nH -- '—' 2>/dev/null || true)
  if [ -n "$hits" ]; then
    red "Em dash found. Use a comma, a colon, parentheses or a full stop."
    printf '%s\n' "$hits" >&2
    fail=1
  fi
fi

# ------------------------------------------------------------- 4. gitleaks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner . || fail=1
elif command -v docker >/dev/null 2>&1; then
  # --staged reads the index, so the working tree is mounted read-only.
  docker run --rm -v "$(git rev-parse --show-toplevel):/repo:ro" -w /repo \
    "$GITLEAKS_IMAGE" git --staged --redact --no-banner . || fail=1
else
  warn "Neither gitleaks nor docker found, skipping the secret scan."
  warn "Install one of them, or accept that this commit went unscanned."
fi

if [ "$fail" -ne 0 ]; then
  red "Pre-commit checks failed. Nothing was committed."
  exit 1
fi

ok "Pre-commit checks passed."
