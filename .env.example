# ---- database ----
POSTGRES_USER=contratos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contratos
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://contratos:change-me@db:5432/contratos

# ---- ingest scope ----
# Comma-separated NIFs to ingest. EMPTY = every entity in the country.
# Odivelas today; add more without touching code.
MUNICIPALITY_NIFS=504293125
# Comma-separated years, or a RANGE like 2012-2026. EMPTY = every year IMPIC offers.
IMPIC_YEARS=2024-2026
# dados.gov.pt dataset slugs (resolved to current file URLs at runtime, never hardcoded)
IMPIC_DATASET_CONTRACTS=contratos-publicos-portal-base-impic-contratos-de-2012-a-2026
IMPIC_DATASET_ENTITIES=contratos-publicos-portal-base-impic-entidades
DADOS_GOV_API=https://dados.gov.pt/api/1

# ---- scheduled ingest (docker-compose.prod.yml only) ----
# ponytail ceiling: these drive `while :; do ...; sleep N; done` loops, not a
# scheduler. See the comment on ingest-delta in docker-compose.prod.yml.
# Seconds between runs of each loop. Deltas are cheap and run nightly; the IMPIC
# bulk re-downloads the year files every time, so it runs weekly and sleeps
# before its first run rather than on every deploy.
INGEST_DELTA_INTERVAL=86400
INGEST_BULK_INTERVAL=604800
# How often the company backfill goes looking for suppliers with no cached
# profile. It paces itself against the nif.pt quota and stops at
# COMPANY_NIFPT_DAILY, so this only sets how often it wakes, never how hard it
# hits the register.
COMPANY_BACKFILL_INTERVAL=86400

# ---- apiaberta (live deltas between IMPIC refreshes) ----
APIABERTA_BASE=https://api.apiaberta.pt/v1/base
APIABERTA_KEY=
APIABERTA_RATE_PER_MIN=30
APIABERTA_PAGE_SIZE=100
# stop paging a delta sync once this many consecutive known ids are seen
APIABERTA_DELTA_STOP_AFTER=200

# ---- api ----
API_CORS_ORIGINS=*
DEFAULT_MUNICIPALITY_NIF=504293125

# ---- scoring thresholds (CCP limits change by law; keep them tunable) ----
# ajuste direto ceilings, EUR: services/goods, public works
AD_LIMIT_SERVICES=20000
AD_LIMIT_WORKS=30000
CONSULTA_PREVIA_LIMIT=75000
# "threshold surfing" = contract value within this fraction below a ceiling
THRESHOLD_SURF_BAND=0.05
# a supplier is "estreante" if it wins here within this many days of its first
# appearance anywhere in the public-contract record (no incorporation dates exist)
# A supplier whose name carries no legal form is a person, not a company.
# One person invoicing a câmara is legal and common at small values, so the
# flag only fires above this amount.
PERSON_FLAG_MIN=25000

# ---- contract flags ----
# A run of awards to one firm for one kind of work, each under a ceiling the run
# as a whole clears. Every one of them is legal alone, which is why the run is
# what gets shown rather than the row.
SLICE_MIN_CONTRACTS=3
SLICE_WINDOW_DAYS=365
# contracts a firm must hold here before "nenhum a concurso" is worth saying
NEVER_TENDERED_MIN=5

NEWCOMER_DAYS=365

# ---- company registry lookup (optional, calls out to the internet) ----
# off by default; every answer is cached in Postgres for COMPANY_CACHE_DAYS
COMPANY_LOOKUP_ENABLED=false
COMPANY_API_BASE=https://api.ptdata.org/v1
COMPANY_SICAE_BASE=http://www.sicae.pt
COMPANY_FOUNDED_BASE=https://empresadb.pt
COMPANY_TIMEOUT=6
COMPANY_CACHE_DAYS=30

# nif.pt: the only source carrying activity status and the registered concelho,
# and the only one behind a quota. Free key is 1/min, 100/day, 1000/month, so it
# is never called from a public request: only `python -m contratos_api.backfill`,
# which paces itself. Leave the key empty and nothing here touches nif.pt.
COMPANY_NIFPT_KEY=
COMPANY_NIFPT_BASE=https://www.nif.pt
COMPANY_NIFPT_INTERVAL=61
COMPANY_NIFPT_DAILY=90

# ---- serving ----
# Canonical origin. Baked into the shell (canonical, hreflang, og:*), the
# sitemap and robots.txt when the web image is built, so it is a build argument
# and not a runtime variable.
# The canonical origin: what <link rel=canonical>, hreflang, the sitemap and
# robots.txt point at. Both hostnames are SERVED (nginx is a catch-all and the
# API does not check Host), but exactly one may be canonical, or search engines
# see two copies of every page. Flipping this one value moves the canonical;
# the other host should then 301 here at the CDN.
PUBLIC_SITE_URL=https://ondevaiparar.pt
# nginx listens on 8080 inside the container. Development only: production
# publishes NO ports at all, because cloudflared dials out and traffic returns
# down that connection.
WEB_PORT=8080
# Shared (CDN) ttl: how long Cloudflare may hold a response.
CACHE_SECONDS=3600
# Browser ttl, deliberately much shorter so a reader who refreshes sees movement.
CACHE_BROWSER_SECONDS=300
# Serve stale instantly and refresh behind it. On two cores this is the
# difference between a reader waiting for a cold aggregate and never knowing.
CACHE_STALE_WHILE_REVALIDATE=86400
# If the origin is down, keep serving the last good answer. Contract data is a
# slow public record: week-old figures beat an error page.
CACHE_STALE_IF_ERROR=604800
# the app is mounted at / but served behind nginx at /api
API_ROOT_PATH=/api
API_VERSION_PREFIX=/v1
INGEST_BATCH_SIZE=20000
DB_POOL_MAX=10

# ---- nginx ----
NGINX_API_UPSTREAM=api:8000
# Who is allowed to speak for a client. In production this is STACK_SUBNET and
# nothing else, because the only thing that can reach nginx is the tunnel.
# Locally it is left wide, which costs nothing because nothing is listening
# publicly.
NGINX_TRUSTED_PROXY=0.0.0.0/0
# The header the real-ip module reads. CF-Connecting-IP in production: the
# Cloudflare edge always overwrites it, so a client cannot forge it, unlike
# X-Forwarded-For which is appended to rather than replaced. Without this every
# request looks like it came from the cloudflared container and the rate limiter
# keys the whole internet to a single address.
NGINX_REAL_IP_HEADER=X-Forwarded-For

# The API answers from national aggregates: /rankings/parties measured ~12s
# against production, /municipalities ~5s, and the data moves daily at most. So
# nginx caches 200s from /api/ on the /var/cache/nginx tmpfs. That is RAM and it
# counts against the web container's memory limit, so raise MEM_WEB with it.
#
# No purge step on deploy: every request the site makes carries the SvelteKit
# build id, so a new bundle asks new URLs and never reads the old shape's cache.
NGINX_CACHE_SIZE=64m
NGINX_CACHE_TTL=1h
# The unit that matters here is a page load, not a request: the município page
# fires about nine calls at once over one HTTP/2 connection, so the BURST is
# what a reader actually meets and the rate only decides how fast the allowance
# comes back. At 5r/s with a burst of 20, two pages opened back to back spent
# the bucket and the third got a 429, which is a reader browsing normally, not
# a crawl. A burst of 60 is six page loads with nothing in between.
#
# Sizing the rate to deter scraping was the wrong test and is dropped. The
# register is IMPIC's open data and the bulk file downloads faster than this API
# can be walked, so there is nothing here to take; the limit exists so one
# client cannot saturate the API and the database. The endpoint that does have
# something to protect is /api/*/companies/ below, and that one is unchanged.
NGINX_API_RATE=20r/s
NGINX_API_BURST=60
# /api/*/companies/ only, and much tighter, because that is the one endpoint
# that reaches out: on a cache miss it fetches sicae.pt and empresadb.pt. The
# limit protects our standing with those registers, not the data, which is open.
# A reader clicking through suppliers fires one of these per click, hence a
# burst generous enough for an enthusiastic afternoon and useless for a walk
# through 100k NIFs.
NGINX_COMPANY_RATE=30r/m
NGINX_COMPANY_BURST=15

# ---- production stack (docker-compose.prod.yml, rootless podman on the VPS) ----
# Written to the box's .env by .github/workflows/deploy.yml, from the GitHub
# `production` environment. Nothing in this section is read in development.
#
# The stack network subnet, pinned rather than left to podman so nginx can name
# it in set_real_ip_from. Keep NGINX_TRUSTED_PROXY equal to this.
STACK_SUBNET=10.89.7.0/24

# Cloudflare tunnel. The token IS the configuration: which hostname reaches
# which service is set on the Cloudflare side against it, so treat it as a
# credential. Point the tunnel's public hostname at http://web:8080.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:2026.9.1
# auto, http2 or quic. Some networks block QUIC; auto falls back on its own.
CLOUDFLARE_TUNNEL_PROTOCOL=auto

# Image refs, written by the deploy workflow from the commit SHA. Set them by
# hand only to pin or roll back, then `podman compose -f docker-compose.prod.yml
# up -d` on the box.
# API_IMAGE=ghcr.io/<owner>/<repo>-api:<sha>
# WEB_IMAGE=ghcr.io/<owner>/<repo>-web:<sha>
# INGEST_IMAGE=ghcr.io/<owner>/<repo>-ingest:<sha>

# ---- postgres tuning ----
# The reasoning for each number sits next to the flags in
# docker-compose.prod.yml. Short version: the box also runs the API, nginx,
# cloudflared and two ingest loops, so postgres does not get the textbook 25% of
# RAM, and the WAL settings exist because a bulk COPY of millions of rows
# checkpoints itself to a stop on the defaults. Re-derive these if the box or
# the loaded years change size.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAINTENANCE_WORK_MEM=192MB
PG_WORK_MEM=6MB
PG_MAX_CONNECTIONS=25
PG_MAX_WAL_SIZE=2GB
PG_MIN_WAL_SIZE=512MB
PG_CHECKPOINT_COMPLETION_TARGET=0.9
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_WAL_COMPRESSION=on
# Two cores total, so a parallel gather gets at most one helper.
PG_MAX_PARALLEL_PER_GATHER=1
PG_MAX_PARALLEL_WORKERS=2
PG_MAX_WORKER_PROCESSES=4

# Memory ceilings. Everything except the database is capped, so an overrun
# kills the offender rather than postgres, which has the largest resident set
# and is what Linux would otherwise choose. Ceilings, not reservations.
MEM_API=512m
MEM_WEB=128m
MEM_MIGRATE=384m
MEM_CLOUDFLARED=128m
MEM_INGEST_DELTA=320m
MEM_INGEST_BULK=640m
MEM_INGEST=640m

# ---- ingest HTTP ----
# Pipe-separated. Empty uses the built-in rotating pool.
USER_AGENTS=
